{
  "name": "ai履歷審核工作流",
  "description": "自動審核履歷的 n8n 工作流 - 從 Google Drive 讀取 PDF，用 AI 分析，存入 Google Sheets",
  "nodes": [
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [608, 256],
      "id": "08d9b797-b720-48b9-b8fb-e479e85cb2b2",
      "name": "把資料夾內的新履歷下載",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "ipwBUz528e69vVFZ",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [800, 256],
      "id": "b5b0286c-7df8-4223-8edc-bf2385021bd0",
      "name": "每份下載下來的原始檔案(Binary)轉成文字"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "你是一位專精於 IT 產業的人資資料編碼員。嚴格根據評分標準進行加總。"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [1008, 256],
      "id": "c7048507-b851-4228-ba7a-52e5ee8acf0f",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "mode": "combine",
        "advanced": true,
        "mergeByFields": {
          "values": [
            {
              "field1": "webViewLink",
              "field2": "resume"
            }
          ]
        },
        "joinMode": "keepNonMatches",
        "outputDataFrom": "input1",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [416, 256],
      "id": "ca249a12-c37c-49a0-9474-c2580040bea2",
      "name": "過濾掉試算表有的舊資料"
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [{"mode": "everyMinute"}]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "__rl": true,
          "value": "1ZCL_65xIF9YyWCb9iTu4TmGfA3KA6sXM",
          "mode": "list",
          "cachedResultName": "應徵者履歷(測試)"
        },
        "event": "fileCreated",
        "options": {}
      },
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [48, 240],
      "id": "b865dde8-a537-4174-be0c-efd755b8684d",
      "name": "每天更新一次：讀取新履歷",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "ipwBUz528e69vVFZ",
          "name": "Google Drive account"
        }
      }
    }
  ],
  "connections": {
    "把資料夾內的新履歷下載": {
      "main": [[{"node": "每份下載下來的原始檔案(Binary)轉成文字", "type": "main", "index": 0}]]
    },
    "每份下載下來的原始檔案(Binary)轉成文字": {
      "main": [[{"node": "AI Agent", "type": "main", "index": 0}]]
    }
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
